# systemd user unit: start auto aim on login/boot. Install with scripts/system/install_autostart.sh.
[Unit]
Description=BOF sentry auto aim (camera, perception, aim)
After=default.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=BOF_CPUS=
ExecStart=/usr/bin/env bash @ROOT@/scripts/start_match.sh
# Restart if the whole launch exits; individual nodes are respawned by the launch file.
Restart=always
RestartSec=3
# 78 = build lacks hik_camera_node (start_match.sh); restarting cannot fix it.
RestartPreventExitStatus=78
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=default.target
