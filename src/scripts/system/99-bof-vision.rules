# Gimbal C board USB CDC (firmware usbd_desc.c: VID 1155 = 0x0483, PID 22336 = 0x5740) -> /dev/bof_gimbal.
# If another STM32 virtual COM port is plugged in (e.g. chassis board), add ATTRS{serial}=="..." from
#   udevadm info -a -n /dev/ttyACM0 | grep serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="bof_gimbal", MODE="0666"
# Hikrobot USB3 industrial cameras (vendor 2bdf): user access without sudo. MVS may already install this.
SUBSYSTEM=="usb", ATTRS{idVendor}=="2bdf", MODE="0666"
